{
  "expo": {
    "name": "Club Bar",
    "slug": "club-bar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "club-bar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dilbek.mediaapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dilbek.mediaapp"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "nodeModules": "./.expo/node_modules",
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000/api",
      "eas": {
        "projectId": "80e6d2f2-8fb5-4715-84c0-02fc3dc1e635"
      }
    }
  }
}