{
  "expo": {
    "name": "Hisvex",
    "slug": "hisvex",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "hisvex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#070512"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dilbek.mediaapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hisvex.app",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#070512"
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Shtrix kodlarni skaner qilish uchun kameradan foydalaniladi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mahsulot rasmini tanlash uchun galereyaga ruxsat kerak.",
          "cameraPermission": "Mahsulotni suratga olish uchun kameradan foydalaniladi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "https://comp-bar-server.onrender.com/api",
      "router": {},
      "eas": {
        "projectId": "2319ed04-72c5-4a00-9ea5-532ecf90bb74"
      }
    },
    "owner": "hisvex",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2319ed04-72c5-4a00-9ea5-532ecf90bb74"
    }
  }
}