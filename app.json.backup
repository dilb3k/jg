{
  "expo": {
    "name": "Hisvex",
    "slug": "hisvex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "hisvex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dilbek.mediaapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dilbek.mediaapp"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "nodeModules": "./.expo/node_modules",
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "https://comp-bar-server-1.onrender.com/api",
      "eas": {
        "projectId": "80e6d2f2-8fb5-4715-84c0-02fc3dc1e635"
      }
    }
  }
}